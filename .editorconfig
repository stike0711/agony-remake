# Einheitliche Formatierung für Windows-PC und Mac.
# Das Projekt liegt auf einem NAS, beide Rechner greifen auf dieselben Dateien zu (siehe wiki/setup.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# In Markdown erzwingen zwei Leerzeichen am Zeilenende einen Umbruch
trim_trailing_whitespace = false

# Originalmaterial und Fremdcode nie umformatieren
[{reference/**,tools/emulator/vamigaweb/**,work/**,backup/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
