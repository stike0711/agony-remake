{
  // Gemeinsame Einstellungen aller Teilprojekte (Kern, Web, Werkzeuge/Tests).
  // erasableSyntaxOnly: nur Syntax, die Node beim direkten Ausführen von .ts entfernen kann (keine enum, namespace,
  // Parameter Properties) – so laufen Kern-Dateien auch in der Asset-Pipeline und in Node.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
