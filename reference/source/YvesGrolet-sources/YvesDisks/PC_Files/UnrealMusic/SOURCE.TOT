
; Badly written player by Charles Deenen

; Put the tune number  0 = High-score
;		      18 = Title      in D0 before jumping
; to SONGINIT

; Type "A"
; Type "Y"
; Type "JS"

openlib= -408
Execbase= 4
close=-36
open=-30
Read= -42
Write= -48
mode_old=1005
******************************* Open screen ********

s:
	bset #1,$bfe001
	move.l execbase,a6
	lea dosname(pc),a1
	Moveq #0,d0
	jsr openlib(a6)
	lea dosbase(pc),a0
	move.l d0,(a0)
	beq error
	move.l (a0),a6
	lea name(pc),a0
	move.l a0,d1
	move.l #mode_old,d2
	jsr open(a6)
	lea conhandle(pc),a0
	move.l d0,(a0)
	beq error
	move.l (a0),d1
	lea text(pc),a0
	move.l a0,d2
	move.l #tend-text,d3
	jsr write(a6)

******************************* Turn IRQ on & init sfx********
	lea oldirq+2(pc),a0
	move.l $6c,(a0)
	lea irq(pc),a0
	move.l a0,$6c
	moveq #18,d0
	bsr initmusic

********************************* Key check *****
reread:
	move.l conhandle(pc),d1
	lea buffer(pc),a0
	move.l a0,d2
	move.l #1,d3
	jsr read(a6)
	lea buffer(pc),a0
	cmp.b #$20,(a0)
	bne noclear
	bsr resetmusic
	bra reread
noclear:
	lea buffer(pc),a0
	cmp.b #$1b,(a0)			;escape
	beq end2
	clr.l d4
	move.b buffer(pc),d4
	cmp.b #$5f,(a0)
	bls keycheck
	sub #$20,d4
keycheck:
	lea buftext(pc),a0
	move.b d4,(a0)
	cmp.b #$40,(a0)		;$30 voor numerieke waarden	
	bls reread
	cmp.b #$42,(a0)
	bgt reread

	move.l conhandle(pc),d1
	move.l a0,d2
	move.l #bufend-buftext,d3
	jsr write(a6)
					;do soundfx
keyA:	cmp.b #"A",d4
	bne keyB
	moveq #0,d0
	bsr initmusic
	bra reread
keyB:	cmp.b #"B",d4
	bne keyC
	moveq #18,d0
	bsr initmusic
keyC:
	bra reread
end2:
	bclr #1,$bfe001
	move #$0f,$dff096
	move.l oldirq+2(pc),$6c
	move.l conhandle(pc),d1
	jsr close(a6)
	rts
error:
	bsr end2
	move.l #-1,d0
rts
lastel:	dc.w 0
*********************************** IRQ *******
irq:
	movem.l d0-d7/a0-a6,-(a7)	;save registers 	
	move.w $dff01c,d1
	btst #5,d1			;test vertical-blank irq
	beq leaveirq
jjras0:
	cmp.b #44,$dff006
	bne jjras0
	move.w #0,$dff180
	move.w #0,$dff182
	move.w #$aaa,$dff186

jjras:
	cmp.b #88,$dff006
	bne jjras
again:
	bsr storegist
	move.w	$dff016,d1
	and.w	#$0400,d1
	bne.s	jjras2
	bsr	player
	move.w #0,$dff180
	move.w #0,$dff182
	move.w #0,$dff186
	bra.s	again
jjras2:
	cmp.b #240,$dff006
	bne jjras2
	move.w #$555,$dff180
	move.w #$555,$dff182
	bsr player
	move.w #$0,$dff180
	move.w #$0,$dff182
leaveirq:
	movem.l (a7)+,d0-d7/a0-a6
oldirq:
	jmp $ffffff

************************************ Text and Data ******
name:
	dc.b 'RAW:0/0/640/256/    UNREAL INGAME MUSIC by MANIACS'
	dc.b ' of NOISE/CD for ORDILOGIC SYSTEMS      '
dosname: 	dc.b 'dos.library',0
Text:		
	dc.b $9b,"3;20H",$9b,"1;33;40m"
	dc.b 'UNREAL MUSIC by MANIACS of NOISE/CD'
	dc.b $9b,"0;33;40m"
	dc.b $9b,"8;20H", "A) High-score tune"
	dc.b $9b,"10;20H","B) Ingame-Title tune"  
	dc.b $9b,"12;20H" ,"ESC) Quit"
	dc.b $9b,"14;20H","Space) Stop current tune"
	dc.b $9b,"16;20H","Right mouse button) forwind tune"
	dc.b $9b,"29;2H"
	dc.b $9b,"3;33;40m","Maniacs of Noise, Gildestr.19b, "
	dc.b "5824 AA, Holthees, Holland, Tel: +31-4782509"
	dc.b $9b,"20;20H",$9b,"0;33;40m"
	dc.b "Your choise please: "
	dc.b 0
Tend:
Buffer:	blk.b 8
buftext:
	dc.b 0,$9b,"20;40H",0
Bufend:
even
dosbase:	dc.l 0
conhandle:	dc.l 0

;********************************************************
;**********************  REAL PLAYER ********************
;********************************************************



initmusic:	bra setmus
resetmusic:	bra clearmusic
storegist:	bra setallreg
player:
and.b	#1,musicon
bne.s	playthen
rts

playthen:
moveq	#0,d4
move.b	novoices,d4

subq.b	#1,tempocnt
cmp.b	#$fe,tempocnt
bne.s	nextvoice
move.b	tempo,tempocnt

nextvoice:
move.l	#varstart,a5
move.l	(a5,d4),a5

cmp.b	#$ff,tempocnt
beq.s	dyt

cmp.b	#0,tempocnt
beq.s	tcnt0
bra.L	compute

tcnt0:
subq.b	#1,nlen-var0(a5)
bpl.L	compute
clr.b	gate-var0(a5)
bra.L	compute

dyt:
cmp.b	#$ff,nlen-var0(a5)
bne.L	compute

loop2:
move.l	vdata-var0(a5),a3

loop1:
moveq	#0,d0

checkout:
move.b	seqno-var0(a5),d0

moveq	#0,d1
move.b	(a3,d0),d1;current sequence# in d1

cmp.b	#$ff,d1;tune finished?
bne.s	notfin

;yes,tune finished
move.b	#$00,seqno
move.b	#$00,seqno-var0+var1
move.b	#$00,seqno-var0+var2
move.b	#$00,seqno-var0+var3

move.b	seqno-var0(a5),d0
move.b	(a3,d0),d1;current sequence# in d1
bra	notstoptune

notfin:
cmp.b	#$fe,d1;tune stop?
bne.s	notstoptune

jmp	clearmusic

notstoptune:
cmp.b	#$7f,d1
bls.s	nottrans

move.b	d1,transpose-var0(a5)
sub.b	#$c0,transpose-var0(a5)
addq.b	#1,seqno-var0(a5)
bra.s	checkout

nottrans:
move.l	#seqstart,a3
asl.w	#2,d1
move.l	(a3,d1),a3;start addr. of current sequence

move.b	seqptr-var0(a5),d0

move.b	(a3,d0),nlen-var0(a5);next byte in sequence (len+control)
and.b	#$1f,nlen-var0(a5);length set!

readagain:
move.b	(a3,d0),d3
move.b	d3,hold
and.b	#$20,hold

cmp.b	#$df,d3;select arpeggio
bls.s	notselarp
move.b	1(a3,d0),arpsel-var0(a5)
addq.b	#1,d0
move.b	(a3,d0),d3
move.b	#0,hold

notselarp:
cmp.b	#$bf,d3
bls.s	notpause

addq.b	#1,seqptr-var0(a5)
cmp.b	#$ff,1(a3,d0)
bne.L	compute
clr.b	seqptr-var0(a5)
addq.b	#1,seqno-var0(a5)
bra.L	compute

notpause:
and.b	#$c0,d3
bmi.s	samchng
beq.s	notsamchng

clr.w	brate-var0(a5)
move.b	1(a3,d0),1+brate-var0(a5)
addq.b	#2,d0
move.b	(a3,d0),enote-var0(a5)
move.b	transpose-var0(a5),d1
add.b	d1,enote-var0(a5)
bra.s 	readnte

samchng:
addq.b	#1,d0
moveq	#0,d1
move.b	(a3,d0),d1;sample# now in d1
asl.w	#2,d1
lea	samdatptr,a4
move.l	(a4,d1),samdata-var0(a5)
move.l	samdata-var0(a5),a4
move.b	28(a4),arpsel-var0(a5)
moveq	#0,d1
move.b	1(a3,d0),d1
bpl.s	notsamchng
addq.b	#1,d0
and.b	#$7f,d1
move.b	d1,arpsel-var0(a5)
move.b	#0,hold
notsamchng:
clr.w	brate-var0(a5)

readnte:
addq.b	#1,d0
move.b	(a3,d0),note-var0(a5)
move.b	transpose-var0(a5),d1
add.b	d1,note-var0(a5)

cmp.b	#$ff,1(a3,d0)
bne.s	notresta
clr.b	seqptr-var0(a5)
addq.b	#1,seqno-var0(a5)
bra.s	dontad

notresta:
addq.b	#1,d0
move.b	d0,seqptr-var0(a5)

dontad:
and.b	#$20,hold
beq.s	stopit
move.b	#2,adsr-var0(a5)
move.l	samdata-var0(a5),a3
move.w	18(a3),volume-var0(a5)
bra	nobend

stopit:
move.w	clearaud-var0(a5),$dff096

notstop:
clr.w	volume-var0(a5)
clr.b	adsr-var0(a5)
clr.w	framecount-var0(a5)
clr.l	pulseptr-var0(a5)
move.b	#1,arpptr-var0(a5)

move.l	samdata-var0(a5),a4
move.w	24(a4),vibdircnt-var0(a5)
lsr.w	#1,vibdircnt-var0(a5)
move.b	#1,vibdirec-var0(a5)
move.b	regstart-var0(a5),d3

move.l	#$dff0a0,a3
move.l	4(a4),(a3,d3);set data location
move.w	2(a4),4(a3,d3);set len

move.b	#1,gate-var0(a5)
bra.l	attack

compute:
;change sample start
moveq	#0,d0
move.l	samdata-var0(a5),a3
move.w	32(a3),d0
beq.s	chkrel

move.w	framecount,d0
and	#1,d0
beq	chkrel
move.l	4(a3),a4
add.l	pulseptr-var0(a5),a4
move.b	regstart-var0(a5),d0
move.l	#$dff0a0,a3
move.l	a4,(a3,d0)

addq.l	#1,pulseptr-var0(a5)
cmp.l	#$20,pulseptr-var0(a5)
bls.s	chkrel
move.l	#$00,pulseptr-var0(a5)
chkrel:
;check release trigger

move.l	samdata-var0(a5),a3
moveq	#0,d0

move.w	30(a3),d0
beq	ratata
cmp.w	framecount-var0(a5),d0
bgt.s	ratata
move.b	#2,adsr-var0(a5)
move.b	#0,gate-var0(a5)
ratata:
addq.w	#1,framecount-var0(a5)
cmp.w	#1,framecount-var0(a5)
bne.s	notyet
move.l	samdata-var0(a5),a3
lea	$dff0a0,a4

moveq	#0,d3
move.b	regstart-var0(a5),d3
move.l	8(a3),(a4,d3);new location
move.w	12(a3),4(a4,d3);new length

notyet:

cmp.w	#0,brate-var0(a5)
bne.s	bendit

;vibrato
move.l	samdata-var0(a5),a3
move.w	framecount-var0(a5),d1
move.b	note-var0(a5),d2
btst	#7,note-var0(a5)
bne.s	vibtrig
cmp.w	#0,22(a3)
beq.l	nobend

cmp.w	22(a3),d1
bls.L	nobend

vibtrig:
move.w	24(a3),d2;vib speed
move.w	26(a3),d3;vib rate

cmp.b	#0,vibdirec-var0(a5)
beq.s	vibup

;vib down
add.w	d3,freq-var0(a5)
subq.w	#1,vibdircnt-var0(a5)
bpl.s	nobend
clr.b	vibdirec-var0(a5)
move.w	d2,vibdircnt-var0(a5)
bra.s	nobend

vibup:
sub.w	d3,freq-var0(a5)
subq.w	#1,vibdircnt-var0(a5)
bpl.s	nobend

move.b	#1,vibdirec-var0(a5)
move.w	d2,vibdircnt-var0(a5)
bra.s	nobend

bendit:
moveq	#0,d0
moveq	#0,d2
move.b	enote-var0(a5),d0
and.b	#$7f,d0
move.w	brate-var0(a5),d1
move.b	d0,d2
asl.b	#1,d2
move.l	#audpertab,a3
move.w	(a3,d2),d2

cmp.b	note-var0(a5),d0
bge.s	bdown

;bend up

add.w	d1,freq-var0(a5)
cmpa.w	freq-var0(a5),d2
bge.s	nobend
move.w	d2,freq-var0(a5)
clr.w	brate-var0(a5)
bra.s	nobend

bdown:
sub.w	d1,freq-var0(a5)
cmpa.w	freq-var0(a5),d2
blt.s	nobend
move.w	d2,freq-var0(a5)
clr.w	brate-var0(a5)

nobend:
and.b	#1,gate-var0(a5)
beq.s	release
move.w	framecount-var0(a5),d1
and.w	#1,d1
bne.s	decv
cmp.b	#0,adsr-var0(a5)
bne.s	decay

attack:
move.l	samdata-var0(a5),a3
move.w	14(a3),d0
add.w	d0,volume-var0(a5)
move.w	volume-var0(a5),d1
cmpa.w	(a3),d1
bls.s	decv
move.w	(a3),volume-var0(a5)
move.b	#1,adsr-var0(a5)
bra.s	decv

decay:
cmp.b	#2,adsr-var0(a5)
beq.s	decv

dosustain:
move.l	samdata-var0(a5),a3
move.w	16(a3),d0
sub.w	d0,volume-var0(a5)
bmi.s	yess
move.w	volume-var0(a5),d1
cmpa.w	18(a3),d1
bge.s	decv
yess:
move.w	18(a3),volume-var0(a5)
move.b	#2,adsr-var0(a5)
bra.s	decv

release:
move.l	samdata-var0(a5),a3
move.w	20(a3),d0
sub.w	d0,volume-var0(a5)
bpl.s	decv
clr.w	volume-var0(a5)

decv:
;arpeggio (28.b*4)

moveq	#0,d1
moveq	#0,d0
move.b	arpsel-var0(a5),d0
move.l	#arptabptr,a3
move.l	(a3,d0),a4;start addr. of current arpeggio table
move.b	arpptr-var0(a5),d0;arpeggio pointer

rere:
move.b	(a4,d0),d1
cmp.b	#$ff,d1
bne.s	notreld
clr.b	d0
move.b	(a4,d0),d0
bra.s	rere

notreld:
cmp	#$fe,d1
beq.s	endarp

addq.b	#1,d0
move.b	d0,arpptr-var0(a5)
cmp.b	#$80,d1
bpl.s	only

add.b	note-var0(a5),d1

only:
and.b	#$7f,d1
move.l	#audpertab,a3
asl.b	#1,d1
move.w	(a3,d1),freq-var0(a5)

endarp:
subq.b	#4,d4
bpl.L	nextvoice
rts

setallreg:
and.b	#1,musicon
bne.s	setthemthen
rts

setthemthen:
moveq	#0,d4
move.b	novoices,d4
lea	$dff0a6,a4
moveq	#0,d3
nextv2:
move.l	#varstart,a5
move.l	(a5,d4),a5

move.b	regstart-var0(a5),d3
move.w	freq-var0(a5),(a4,d3)

move.w	volume-var0(a5),2(a4,d3)

move.w	setaud-var0(a5),$dff096

subq.b	#4,d4
bpl.s	nextv2
rts


setmus:
clr.b	transpose
clr.b	transpose-var0+var1
clr.b	transpose-var0+var2
clr.b	transpose-var0+var3

clr.b	nlen
clr.b	nlen-var0+var1
clr.b	nlen-var0+var2
clr.b	nlen-var0+var3

clr.b	seqptr
clr.b	seqptr-var0+var1
clr.b	seqptr-var0+var2
clr.b	seqptr-var0+var3

clr.b	seqno
clr.b	seqno-var0+var1
clr.b	seqno-var0+var2
clr.b	seqno-var0+var3

move.b	#2,adsr
move.b	#2,adsr-var0+var1
move.b	#2,adsr-var0+var2
move.b	#2,adsr-var0+var3

clr.b	gate
clr.b	gate-var0+var1
clr.b	gate-var0+var2
clr.b	gate-var0+var3

clr.w	volume
clr.w	volume-var0+var1
clr.w	volume-var0+var2
clr.w	volume-var0+var3

lea	voistart,a4
move.l	(a4,d0),vdata
move.l	4(a4,d0),vdata-var0+var1
move.l	8(a4,d0),vdata-var0+var2
move.l	12(a4,d0),vdata-var0+var3
move.b	16(a4,d0),novoices
move.b	17(a4,d0),tempo
move.w	#$000f,$dff096
move.b	#1,musicon
rts

clearmusic:
clr.b	musicon
move.w	#$000f,$dff096
rts

even
voistart:
dc.l	seqseq0,seqseq1,seqseq2,seqseq3
dc.b	12,2;(#voices-1)*4,tempo
dc.l	seqseq4,seqseq5,seqseq6,seqseq7
dc.b	12,2

hold:		dc.b	0
tempocnt:	dc.b	0
tempo:		dc.b	0
novoices:	dc.b	0
musicon:	dc.b	0
even

var0:
nlen:		dc.b	0
seqno:		dc.b	0
seqptr:		dc.b	0
note:		dc.b	0
enote:		dc.b	0
adsr:		dc.b	0
gate:		dc.b	0
vibdirec:	dc.b	0
regstart:	dc.b	$00
even
brate:		dc.w	0
vibdircnt:	dc.w	0
freq:		dc.w	0
framecount:	dc.w	0
volume:		dc.w	0
clearaud:	dc.w	$0001
setaud:		dc.w	$8001
samdata:	dc.l	0
vdata:		dc.l	seqseq0
arpptr:		dc.b	0
even
pulseptr:	dc.l	0
arpsel:		dc.b	0
transpose:	dc.b	0
even
var1:
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	$10
even
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	$0002
	dc.w	$8002
	dc.l	0
	dc.l	seqseq1
	dc.b	0
even
	dc.l	0
	dc.b	0
	dc.b	0
even
var2:
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	$20
even
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	$0004
	dc.w	$8004
	dc.l	0
	dc.l	seqseq2
	dc.b	0
even
	dc.l	0
	dc.b	0
	dc.b	0
even
var3:
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	0
	dc.b	$30
even
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	0
	dc.w	$0008
	dc.w	$8008
	dc.l	0
	dc.l	seqseq3
	dc.b	0
even
	dc.l	0
	dc.b	0
	dc.b	0
even
varstart:	dc.l	var0,var1,var2,var3

seqstart:
		dc.l	s00,s01,s02,s03,s04,s05,s06,s07
		dc.l	s08,s09,s0a,s0b,s0c,s0d,s0e,s0f
		dc.l	s10,s11,s12,s13,s14,s15,s16,s17
		dc.l	s18,s19,s1a,s1b,s1c,s1d,s1e,s1f
		dc.l	s20,s21,s22,s23,s24,s25,s26,s27
		dc.l	s28,s29,s2a,s2b,s2c,s2d,s2e,s2f
		dc.l	s30,s31,s32,s33,s34,s35,s36,s37
		dc.l	s38,s39,s3a,s3b,s3c,s3d,s3e,s3f
 		dc.l	s40,s41,s42,s43,s44,s45,s46,s47
		dc.l	s48,s49,s4a,s4b,s4c,s4d,s4e,s4f
;		dc.l	s50,s51,s52,s53,s54,s55,s56,s57

