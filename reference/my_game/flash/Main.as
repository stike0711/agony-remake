package{    import flash.display.MovieClip;    import flash.events.Event;    import flash.events.MouseEvent;    import flash.events.TouchEvent    import flash.events.GestureEvent    import flash.events.GesturePhase    import flash.events.TransformGestureEvent    import flash.events.PressAndTapGestureEvent    import flash.ui.Multitouch;    import flash.ui.MultitouchInputMode;    import flash.media.SoundChannel;        public class Main extends MovieClip    {                const PLAYER_SPEED:int = 6;        const BACKGROUND_SPEED:Number = 2;        const FOREGROUND_SPEED:Number = 5;        const BACKGROUND_X_START:Number = 1100.0;        const FOREGROUND_X_START:Number = 1300.0;        const BACK_AND_FOREGROUND_Y_OFFSET:Number = 35.0;        // für Touchevents wichtig/notwendig!        Multitouch.inputMode = MultitouchInputMode.GESTURE;        public var backgroundMusic:BackgroundMusic = new BackgroundMusic();        public var bgmSoundChannel:SoundChannel = backgroundMusic.play();                public var player_mc:Player = new Player();                public var enemyTimer:int;        public var enemyRandomY:int;        public var newEnemy:Enemy1;        public var enemys:Array;        public var shotTimer:int;        public var newShot:Shot;        public var shots:Array;        public var background_mc:Background = new Background();        public var foreground_mc:Foreground = new Foreground();        //public var parallaxContainer:MovieClip;                public var playerX:Number;        public var playerY:Number;        public var playerMustX:Number;        public var playerMustY:Number;        public function onBackgroundMusicFinished(event:Event):void        {            bgmSoundChannel = backgroundMusic.play();            bgmSoundChannel.addEventListener(Event.SOUND_COMPLETE, onBackgroundMusicFinished);        }        public function Main()        {            bgmSoundChannel.addEventListener(Event.SOUND_COMPLETE, onBackgroundMusicFinished);            init();        }        private function init(start:Boolean = false):void        {            enemyTimer = 0;            enemyRandomY = 0;            enemys = new Array();            shotTimer = 0;            shots = new Array();                      playerX = 50.0;            playerY = 350.0;            playerMustX = playerX;            playerMustY = playerY;            gameOverText.visible = false;            startGameText.visible = false;            player_mc.x = playerX;            player_mc.y = playerY;            background_mc.x = BACKGROUND_X_START;            background_mc.y = BACK_AND_FOREGROUND_Y_OFFSET;            foreground_mc.x = FOREGROUND_X_START;            foreground_mc.y = BACK_AND_FOREGROUND_Y_OFFSET;            //parallaxContainer = new MovieClip();                     //parallaxContainer.addChild(background_mc);            //stage.addChild(parallaxContainer);            stage.addChild(background_mc);            // bringt Wellen vor scrollenden Background            stage.addChild(waves_mc);            stage.addChild(foreground_mc);                        if (start)            {                stage.addChild(player_mc);                stage.addEventListener(MouseEvent.CLICK, mousePosition);                stage.addEventListener(MouseEvent.RIGHT_CLICK, fireShot);                stage.addEventListener(GestureEvent.GESTURE_TWO_FINGER_TAP, fireShot);                addEventListener(Event.ENTER_FRAME, gameLoop);            } else {                startGameText.visible = true;                stage.addChild(startGameText);                addEventListener(Event.ENTER_FRAME, menuLoop);                startGameText.addEventListener(MouseEvent.CLICK, startGame);            }                    }        private function menuLoop(event:Event = null):void        {                        moveObjects();        }        private function startGame(event:Event = null):void        {                        startGameText.removeEventListener(MouseEvent.CLICK, startGame);            removeEventListener(Event.ENTER_FRAME, menuLoop);            init(true);        }        private function gameLoop(event:Event = null):void        {                        // loop here            addObjects();            moveObjects();            collisions();            //updateScore();            updateTimers();        }        private function addObjects():void        {            addEnemy();        }        private function addEnemy():void        {            if((enemyTimer >= 20) && (enemys.length < 7))            {                enemyRandomY = int(Math.random()*700) + 60;                newEnemy = new Enemy1();                newEnemy.x = 1200;                newEnemy.y = enemyRandomY;                stage.addChild(newEnemy);                enemys.push(newEnemy);                enemyTimer = 0;            }        }        private function fireShot(event:GestureEvent):void        {            if(shotTimer >= 6)            {                newShot = new Shot();                newShot.x = player_mc.x+50;                newShot.y = player_mc.y+(player_mc.height/2)+52;                stage.addChild(newShot);                shots.push(newShot);                shotTimer = 0;            }        }        private function moveObjects():void        {            doParallax();            movePlayer();            moveEnemys();            moveShots();        }        private function doParallax():void        {                        if (background_mc.x < -background_mc.width) //12000            {                background_mc.x = BACKGROUND_X_START;            } else {                background_mc.x -= BACKGROUND_SPEED;            }            if (foreground_mc.x < -foreground_mc.width) //17943            {                foreground_mc.x = FOREGROUND_X_START;            } else {                foreground_mc.x -= FOREGROUND_SPEED;            }                    }        private function movePlayer():void        {                        //player_mc.height max: 124            //player_mc.width max: 64            if ((playerMustX - ((64/2) + player_mc.x)) > (PLAYER_SPEED+2))            {                player_mc.x += PLAYER_SPEED;            }            if ((playerMustX - ((64/2) + player_mc.x)) < (PLAYER_SPEED+2))            {                // Damit es beim nach Linksbewegen etwas schneller aussieht                player_mc.x -= PLAYER_SPEED+1;            }            // 140 ist mehr am Rumpf der Eule            if ((playerMustY - ((140/2) + player_mc.y)) > (PLAYER_SPEED+1))            {                player_mc.y += PLAYER_SPEED;            }            if ((playerMustY - ((140/2) + player_mc.y)) < (PLAYER_SPEED+1))            {                player_mc.y -= PLAYER_SPEED;            }                   }        private function mousePosition(event:MouseEvent):void        {            playerMustX = mouseX;            playerMustY = mouseY;        }        private function moveEnemys():void        {            for (var i:int = 0; i < enemys.length; ++i)            {                if (enemys.length > 0)                {                    if (enemys[i].x < -enemys[i].width)                    {                        enemys[i].parent.removeChild(enemys[i]);                        enemys.splice(i,1);                        break;                    } else {                        enemys[i].x -= PLAYER_SPEED+1;                    }                }            }        }        private function moveShots():void        {            for (var i:int = 0; i < shots.length; ++i)            {                if (shots.length > 0)                {                    if (shots[i].x > 1024+shots[i].width)                    {                        shots[i].parent.removeChild(shots[i]);                        shots.splice(i,1);                        break;                    } else {                        shots[i].x += PLAYER_SPEED+5;                    }                }            }        }        private function collisions():void        {            for (var j:int = enemys.length-1; j >= 0; j--)            {                if (enemys.length > 0)                {                    if (player_mc.hitTestPoint(enemys[j].x, enemys[j].y, true))                    {                        //enemys[j].parent.removeChild(enemys[j]);                        //enemys.splice(j,1);                        //break;                        parent.removeChild(player_mc);                        gameOver();                    }                }            }            //hier muss noch die überprüfung mit den shots hin!!            for (var j:int = enemys.length-1; j >= 0; j--)            {                if (enemys.length > 0)                {                    for (var i:int = shots.length-1; i >= 0; i--)                    {                        if (shots[i].hitTestObject(enemys[j]))                        {                            enemys[j].parent.removeChild(enemys[j]);                            enemys.splice(j,1);                            shots[i].parent.removeChild(shots[i]);                            shots.splice(i,1);                            break;                        }                    }                }            }        }        private function updateTimers():void        {            enemyTimer++;            shotTimer++;        }        private function gameOver():void        {                        removeEventListener(Event.ENTER_FRAME, gameLoop);            stage.removeEventListener(MouseEvent.CLICK, mousePosition);            stage.removeEventListener(MouseEvent.RIGHT_CLICK, fireShot);            stage.removeEventListener(GestureEvent.GESTURE_TWO_FINGER_TAP, fireShot);                        removeEnemys();            removeShots();            addEventListener(Event.ENTER_FRAME, menuLoop);                        stage.addChild(gameOverText);            gameOverText.visible = true;            gameOverText.addEventListener(MouseEvent.CLICK, startGame);        }        private function removeEnemys():void        {                        for (var i:int = 0; i < enemys.length; ++i)            {                if (enemys.length > 0)                {                    enemys[i].parent.removeChild(enemys[i]);                }            }            enemys = [];         }        private function removeShots():void        {                        for (var i:int = 0; i < shots.length; ++i)            {                if (shots.length > 0)                {                    shots[i].parent.removeChild(shots[i]);                }            }            shots = [];         }    }}